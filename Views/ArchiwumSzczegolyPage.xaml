<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ClassroomTablets.Models"
             x:Class="ClassroomTablets.Views.ArchiwumSzczegolyPage"
             BackgroundColor="#FBEAD9"
             Title="Szczegóły lekcji">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

   
        <Frame Grid.Row="0" BackgroundColor="#5B6A9C" CornerRadius="16" Padding="16" HasShadow="False">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="NaglowekLabel" FontSize="18" FontAttributes="Bold" TextColor="White" />
                <Label x:Name="NauczycielLabel" FontSize="13" TextColor="#DCE1F0" />
                <Label x:Name="LiczbaUczniowLabel" FontSize="12" TextColor="#DCE1F0" />
            </VerticalStackLayout>
        </Frame>

       
        <CollectionView Grid.Row="1" x:Name="SzczegolyCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ArchiwalnaSesja">
                    <Frame BackgroundColor="White" CornerRadius="12" Padding="12" Margin="0,0,0,10" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding StudentName}"
                                   FontAttributes="Bold" FontSize="15" TextColor="#2E3A59" />

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding DeviceId}"
                                   FontSize="13" TextColor="#5B6A9C" HorizontalTextAlignment="End" />

                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   FontSize="12" TextColor="#6B7280" Margin="0,4,0,0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Połączono: " />
                                        <Span Text="{Binding DataPolaczenia, StringFormat='{0:HH:mm}'}" FontAttributes="Bold" />
                                        <Span Text="   Rozłączono: " />
                                        <Span Text="{Binding DataRozlaczenia, StringFormat='{0:HH:mm}'}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
